# Copy the values you need into your deploy platform's environment variable
# settings (e.g. Vercel Project Settings -> Environment Variables) — this
# file itself is never read by Vite, it's just a reference. See src/config.ts
# for how these are consumed and DEPLOYMENT.md for the full deploy guide.
#
# Local dev doesn't need any of these (see .env.development) — they're for
# a production build where the frontend (Vercel) and backend (Render/
# Railway) are deployed as separate origins.

# Backend's public base URL — no trailing slash. Required for a prod build;
# unset, API_BASE_URL falls back to "" (same-origin, only correct when a
# proxy sits in front of both, e.g. local dev's Vite proxy).
VITE_API_URL=https://zircle-backend.onrender.com

# Production TURN relay for voice channels (see useVoiceChannel.ts's
# resolveIceServers()) — optional. Without it, only Google's public STUN
# server is used, which can't traverse a symmetric NAT/restrictive firewall
# between two peers. Two mutually exclusive ways to configure one:

# Option A — a managed provider (e.g. Metered.ca) that hands out fresh,
# short-lived credentials over a GET endpoint:
# VITE_TURN_API_URL=https://your-app.metered.live/api/v1/turn/credentials?apiKey=your-api-key

# Option B — a single static TURN server (e.g. self-hosted coturn) with
# long-lived credentials. All three must be set together or none are used.
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_PASSWORD=your-turn-password
