# Used by `npm run build:electron` (vite build --mode electron ...) to embed
# a real backend URL into the packaged desktop app — unlike the browser
# build, there's no Vite dev proxy or same-origin page to fall back on
# (Electron loads dist-electron/index.html from file://), so this must
# always be set for the desktop app to reach a backend at all.
VITE_API_URL=https://zircle-backend.onrender.com

# Production TURN relay for voice channels (see useVoiceChannel.ts's
# resolveIceServers()) — unset in dev/LAN, where STUN alone is enough since
# there's no symmetric NAT/restrictive firewall between peers to traverse.
#
# Option A — managed provider (Metered.ca, or a backend proxy in front of
# Xirsys) that hands out fresh short-lived credentials over HTTP:
# VITE_TURN_API_URL=https://your-app.metered.live/api/v1/turn/credentials?apiKey=your-api-key
#
# Option B — a single static TURN server (e.g. self-hosted coturn). All
# three must be set together or none are used.
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_PASSWORD=your-turn-password
